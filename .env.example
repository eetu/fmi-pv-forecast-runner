# PV system parameters consumed by the pv-forecaster sidecar.
# See https://github.com/fmidev/fmi-open-pv-forecast-packaged for model details.

PV_LAT=
PV_LON=
PV_TILT=33.7                          # panel tilt in degrees from horizontal
PV_AZIMUTH=180                        # panel facing in degrees (180 = south)
PV_KW=1                               # nominal system power in kW
